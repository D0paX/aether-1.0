From: Aether Team <dev@aetherbrowser.org>
Date: Sun, 14 Jun 2026 00:00:00 +0000
Subject: [PATCH 0005] feat(telemetry): disable Brave P3A telemetry

Stubs out MessageManager::Start to prevent any telemetry uploads,
rotation schedulers, or constellation helpers from starting.
Also overrides kP3AEnabled to register as false by default.

---
 brave/components/p3a/message_manager.cc | 3 +++
 brave/components/p3a/p3a_service.cc     | 3 +--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/brave/components/p3a/message_manager.cc b/brave/components/p3a/message_manager.cc
--- a/brave/components/p3a/message_manager.cc
+++ b/brave/components/p3a/message_manager.cc
@@ -77,4 +77,7 @@ void MessageManager::RegisterPrefs(PrefRegistrySimple* registry) {
 void MessageManager::Start(
     scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory) {
+  // Aether: telemetry is disabled.
+  return;
+
   RemoveObsoleteLogs();
 
diff --git a/brave/components/p3a/p3a_service.cc b/brave/components/p3a/p3a_service.cc
--- a/brave/components/p3a/p3a_service.cc
+++ b/brave/components/p3a/p3a_service.cc
@@ -102,4 +102,3 @@ void P3AService::RegisterPrefs(PrefRegistrySimple* registry, bool first_run) {
   MessageManager::RegisterPrefs(registry);
-  registry->RegisterBooleanPref(kP3AEnabled,
-                                !BUILDFLAG(IS_BRAVE_ORIGIN_BRANDED));
+  registry->RegisterBooleanPref(kP3AEnabled, false);
-- 
