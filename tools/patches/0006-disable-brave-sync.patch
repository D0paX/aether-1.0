From: Aether Team <dev@aetherbrowser.org>
Date: Mon, 15 Jun 2026 00:00:00 +0000
Subject: [PATCH 0007] feat(sync): disable Brave Sync settings and profile menu UI

Stubs out ProfileMenuView::BuildSyncInfo to prevent sync promos,
replaces settings-brave-sync-page element with a static placeholder,
and removes the sync item from the settings sidebar.

---
 chrome/browser/resources/settings/basic_page/basic_page.html | 11 +++++++++--
 chrome/browser/resources/settings/settings_menu/settings_menu.html | 7 -------
 chrome/browser/ui/views/profiles/profile_menu_view.cc | 3 +++
 3 files changed, 12 insertions(+), 9 deletions(-)

diff --git a/chrome/browser/resources/settings/basic_page/basic_page.html b/chrome/browser/resources/settings/basic_page/basic_page.html
--- a/chrome/browser/resources/settings/basic_page/basic_page.html
+++ b/chrome/browser/resources/settings/basic_page/basic_page.html
@@ -80,5 +80,12 @@
       <template is="dom-if" route-path="/braveSync">
-        <settings-section page-title="$i18n{braveSync}" section="braveSync">
-          <settings-brave-sync-page prefs="{{prefs}}"></settings-brave-sync-page>
-        </settings-section>
+        <settings-section page-title="Sync" section="braveSync">
+          <div class="card">
+            <div class="aether-sync-stub" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; text-align: center;">
+              <div class="aether-sync-title" style="font-size: 1.5rem; font-weight: 500; color: var(--cr-primary-text-color); margin-bottom: 8px;">Sign in to Aether</div>
+              <div class="aether-sync-desc" style="color: var(--cr-secondary-text-color); font-size: 1rem;">Aether sync coming soon</div>
+            </div>
+          </div>
+        </settings-section>
       </template>
diff --git a/chrome/browser/resources/settings/settings_menu/settings_menu.html b/chrome/browser/resources/settings/settings_menu/settings_menu.html
--- a/chrome/browser/resources/settings/settings_menu/settings_menu.html
+++ b/chrome/browser/resources/settings/settings_menu/settings_menu.html
@@ -62,7 +62,0 @@
-        <a role="menuitem" id="braveSync" href="/braveSync"
-            class="cr-nav-menu-item" hidden="[[!pageVisibility_.braveSync]]">
-          <cr-icon icon="cr:sync"></cr-icon>
-          $i18n{braveSync}
-          <cr-ripple></cr-ripple>
-        </a>
diff --git a/chrome/browser/ui/views/profiles/profile_menu_view.cc b/chrome/browser/ui/views/profiles/profile_menu_view.cc
--- a/chrome/browser/ui/views/profiles/profile_menu_view.cc
+++ b/chrome/browser/ui/views/profiles/profile_menu_view.cc
@@ -120,3 +120,6 @@
 void ProfileMenuView::BuildSyncInfo() {
+  // Aether: Brave Sync and related promotions are disabled.
+  return;
+
   Profile* profile = GetProfile();
-- 
2.54.0
