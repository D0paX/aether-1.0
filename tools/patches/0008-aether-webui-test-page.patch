From: Aether Team <dev@aetherbrowser.org>
Date: Mon, 15 Jun 2026 00:00:00 +0000
Subject: [PATCH 0008] feat(webui): add aether-webui test page

Wires Aether's React WebUI index.html and assets into Chromium's WebUI
system, serving from chrome://aether-webui/ using content::WebUIDataSource.
---
 aether/src/browser/webui/aether_webui_test_ui.cc              | 33 ++++++++++++++++++
 aether/src/browser/webui/aether_webui_test_ui.h               | 16 +++++++++
 chrome/browser/BUILD.gn                                       |  1 +
 chrome/browser/ui/webui/chrome_web_ui_controller_factory.cc   |  4 +++
 chrome/chrome_paks.gni                                        |  4 +++
 5 files changed, 58 insertions(+)
 create mode 100644 aether/src/browser/webui/aether_webui_test_ui.cc
 create mode 100644 aether/src/browser/webui/aether_webui_test_ui.h

diff --git a/aether/src/browser/webui/aether_webui_test_ui.h b/aether/src/browser/webui/aether_webui_test_ui.h
new file mode 100644
--- /dev/null
+++ b/aether/src/browser/webui/aether_webui_test_ui.h
@@ -0,0 +1,16 @@
+#ifndef BROWSER_WEBUI_AETHER_WEB_UI_TEST_UI_H_
+#define BROWSER_WEBUI_AETHER_WEB_UI_TEST_UI_H_
+
+#include "content/public/browser/web_ui_controller.h"
+
+// C++ WebUI controller for chrome://aether-webui/.
+// Serves Aether's React-based WebUI frontend in the compiled browser binary.
+class AetherWebUITestUI : public content::WebUIController {
+ public:
+  explicit AetherWebUITestUI(content::WebUI* web_ui);
+  ~AetherWebUITestUI() override;
+
+  AetherWebUITestUI(const AetherWebUITestUI&) = delete;
+  AetherWebUITestUI& operator=(const AetherWebUITestUI&) = delete;
+};
+
+#endif  // BROWSER_WEBUI_AETHER_WEB_UI_TEST_UI_H_
diff --git a/aether/src/browser/webui/aether_webui_test_ui.cc b/aether/src/browser/webui/aether_webui_test_ui.cc
new file mode 100644
--- /dev/null
+++ b/aether/src/browser/webui/aether_webui_test_ui.cc
@@ -0,0 +1,33 @@
+#include "aether/src/browser/webui/aether_webui_test_ui.h"
+
+#include <memory>
+#include <string>
+
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+
+// Generated grit resource headers.
+// These headers are produced by the GRIT compiler from the .grd resource mapping.
+#include "chrome/grit/aether_webui_test_resources.h"
+#include "chrome/grit/aether_webui_test_resources_map.h"
+
+namespace {
+
+void CreateAndAddAetherWebUIDataSource(Profile* profile) {
+  content::WebUIDataSource* source =
+      content::WebUIDataSource::CreateAndAdd(profile, "aether-webui");
+
+  // Disable CSP for the test page to prevent security policy load blocks.
+  source->DisableContentSecurityPolicy();
+
+  // Add the resource path mapping generated by GRIT
+  source->AddResourcePaths(
+      base::make_span(kAetherWebuiTestResources, kAetherWebuiTestResourcesSize));
+
+  // Set the default resource index.html
+  source->SetDefaultResource(IDR_AETHER_WEBUI_TEST_INDEX_HTML);
+}
+
+}  // namespace
+
+AetherWebUITestUI::AetherWebUITestUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  CreateAndAddAetherWebUIDataSource(Profile::FromWebUI(web_ui));
+}
+
+AetherWebUITestUI::~AetherWebUITestUI() = default;
diff --git a/chrome/browser/ui/webui/chrome_web_ui_controller_factory.cc b/chrome/browser/ui/webui/chrome_web_ui_controller_factory.cc
--- a/chrome/browser/ui/webui/chrome_web_ui_controller_factory.cc
+++ b/chrome/browser/ui/webui/chrome_web_ui_controller_factory.cc
@@ -38,6 +38,7 @@
 #include "chrome/browser/ui/webui/version/version_ui.h"
+#include "aether/src/browser/webui/aether_webui_test_ui.h"
 
 #if BUILDFLAG(IS_ANDROID)
@@ -1000,6 +1001,8 @@
   if (url.host_piece() == chrome::kChromeUIVersionHost)
     return &NewWebUI<VersionUI>;
+  if (url.host_piece() == "aether-webui")
+    return &NewWebUI<AetherWebUITestUI>;
 
   return nullptr;
 }
diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -2100,6 +2100,7 @@
     "//ui/webui",
+    "//aether/src/browser/webui:aether_webui_test",
     "//ui/webui/resources/js/browser_bridge:mojo_bindings",
     "//v8",
diff --git a/chrome/chrome_paks.gni b/chrome/chrome_paks.gni
--- a/chrome/chrome_paks.gni
+++ b/chrome/chrome_paks.gni
@@ -100,6 +100,8 @@
     sources += [
       "$root_gen_dir/chrome/browser_resources.pak",
+      "$root_gen_dir/chrome/aether_webui_test_resources.pak",
     ]
     deps += [
       "//chrome/browser:resources",
+      "//aether/src/browser/webui:aether_webui_test_resources",
     ]
