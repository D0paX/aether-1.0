       "mode": "force-https",
       "policy": "custom"
     },
@@ -196,8 +196,8 @@ constexpr std::string_view kBraveHstsJson = R"brave_hsts_json({
     {
-      "name": "componentupdater.brave.com",
+      "name": "componentupdater.aetherbrowser.com",
