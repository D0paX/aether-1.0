{
  "name": "aether",
  "version": "0.1.0",
  "private": true,
  "description": "Aether Browser — production-grade browser built on Brave/Chromium",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "src/webui"
  ],
  "scripts": {
    "webui:dev": "pnpm --filter @aether/webui dev",
    "webui:build": "pnpm --filter @aether/webui build",
    "webui:lint": "pnpm --filter @aether/webui lint",
    "webui:test": "pnpm --filter @aether/webui test",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {}
}
