# Aether Browser — .gitattributes
# Chromium builds are sensitive to line endings. Wrong line endings in Python or shell scripts will silently break the build.

# Default:
* text=auto eol=lf

# Windows-specific scripts (must use CRLF):
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Unix scripts (must use LF):
*.sh text eol=lf
*.py text eol=lf

# C++ and Chromium source:
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.mm text eol=lf

# Web and TypeScript:
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf

# Rust:
*.rs text eol=lf

# Build system:
*.gn text eol=lf
*.gni text eol=lf
*.mojom text eol=lf

# Documentation:
*.md text eol=lf
*.txt text eol=lf

# Patch files:
*.patch text eol=lf

# Binary files (never text-process these):
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.pdb binary

# Linguist (mark generated files in GitHub diffs):
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
Cargo.lock linguist-generated=true
