{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "/window_controls.mojom-webui.js": ["./src/chrome/services/stubs/window_controls.mojom-webui.ts"],
      "/tab_manager.mojom-webui.js": ["./src/chrome/services/stubs/tab_manager.mojom-webui.ts"],
      "/navigation.mojom-webui.js": ["./src/chrome/services/stubs/navigation.mojom-webui.ts"]
    }
  },
  "include": ["src"]
}
