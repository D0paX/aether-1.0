import("//tools/grit/grit_rule.gni")

# Generate grit resources from the .grd mapping
grit("aether_webui_test_resources") {
  source = "resources/aether_webui_test_resources.grd"
  outputs = [
    "grit/aether_webui_test_resources.h",
    "grit/aether_webui_test_resources_map.cc",
    "grit/aether_webui_test_resources_map.h",
    "aether_webui_test_resources.pak",
  ]
  output_dir = "$root_gen_dir/chrome"
}

# Native C++ WebUI controller target
source_set("aether_webui_test") {
  sources = [
    "aether_webui_test_ui.cc",
    "aether_webui_test_ui.h",
  ]

  deps = [
    ":aether_webui_test_resources",
    "//base",
    "//content/public/browser",
  ]
}
