# Aether Browser — clangd configuration
# Configures C++ language server for Chromium/Brave development.
# Requires: compile_commands.json generated by running: gn gen out/Debug --export-compile-commands

CompileFlags:
  # Standard used throughout Chromium
  Add:
    - "-std=c++20"
    - "-xc++"
    - "-I.."
    - "-IC:/src/brave-browser/src"
    - "-IC:/src/brave-browser/src/out/AetherDebug/gen"
  # Remove compiler flags that clangd does not understand
  Remove:
    - "-Wno-unused-but-set-variable"

InlayHints:
  Enabled: false

Diagnostics:
  # Suppress Chromium's macro-heavy code from generating noise
  Suppress:
    - "pp_including_mainfile_in_preamble"
    - "drv_unknown_argument"

Index:
  Background: Build
