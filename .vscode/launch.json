{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Aether (Windows)",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "symbolSearchPath": "out\\Default",
      "sourceFileMap": {
        "/source": "${workspaceFolder}"
      }
    },
    {
      "name": "WebUI Vitest",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@aether/webui", "test", "--run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
